{
  "name": "data-with-anil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "node --env-file-if-exists=.env scripts/server.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/prerender.tsx --outDir .prerender && node scripts/generate-seo.mjs",
    "build:pages": "npm run build && node scripts/copy-pages-docs.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
