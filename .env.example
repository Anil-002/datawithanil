# Public website configuration (safe to bundle). Leave unknown details empty.
# Email is configured in src/config.ts as anil0singh02@gmail.com.
VITE_SITE_URL=
# Hosting path: / for a root site, /datawithanil/ for GitHub project Pages.
VITE_BASE_PATH=/
# GitHub Pages has no server API; true uses the email-only contact page.
VITE_STATIC_HOSTING=false
# Use a local public asset path, such as /images/anil.webp.
VITE_PORTRAIT_URL=
# Optional analytics requires the site's opt-in consent flow.
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=

# Server-only production configuration. NEVER prefix these with VITE_.
SITE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate at least 32 random characters; used to hash request IPs for throttling.
INQUIRY_RATE_LIMIT_SECRET=
# Optional additional exact origins, comma-separated (e.g. a staging website).
ALLOWED_ORIGINS=

# Local server only. Defaults to 8787 and ../../work/inquiries.json.
PORT=8787
# INQUIRY_DATA_PATH=C:/absolute/private/path/inquiries.json
# ALLOW_LOCAL_INQUIRIES=true
